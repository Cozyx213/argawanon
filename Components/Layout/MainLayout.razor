@inherits LayoutComponentBase

<header class="sticky top-0 z-40 border-b border-sand-200 bg-sand-50/95 backdrop-blur">
    <nav aria-label="Main" class="container-page flex items-center justify-between py-3">
        <a href="" class="font-display text-2xl font-bold text-ocean-700">
            Argawanon<span class="text-coral-500" aria-hidden="true">.</span>
        </a>
        <div class="flex gap-1">
            <NavLink href="" Match="NavLinkMatch.All" class="rounded-full px-4 py-2 font-semibold text-ocean-900 hover:bg-ocean-50" ActiveClass="bg-ocean-100">Home</NavLink>
            <NavLink href="explore" class="rounded-full px-4 py-2 font-semibold text-ocean-900 hover:bg-ocean-50" ActiveClass="bg-ocean-100">Explore</NavLink>
        </div>
    </nav>
</header>

<main>
    @Body
</main>

<footer class="mt-20 bg-ocean-900 text-ocean-50">
    <div class="container-page grid gap-10 py-12 md:grid-cols-3">
        <section aria-labelledby="about-heading" class="md:col-span-2">
            <h2 id="about-heading" class="font-display text-xl font-semibold text-white">About Argawanon</h2>
            <p class="mt-3 max-w-prose leading-relaxed">
                Argawanon is a student school project that introduces Argao, a heritage town on the southeastern
                coast of Cebu, through its old churches and plazas, local food, and seaside nature.
            </p>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-ocean-100">
                Food and stay listings are fictional demonstrations, and every review marked "sample" is made up.
                The site makes no claims about real businesses, prices or opening hours. Photos are by Wikimedia Commons
                contributors and are credited on each place page.
            </p>
        </section>
        <nav aria-label="Footer">
            <h2 class="font-display text-xl font-semibold text-white">Explore</h2>
            <ul class="mt-3 space-y-2">
                <li><a class="hover:underline" href="">Home</a></li>
                @foreach (var category in Places.Categories)
                {
                    <li><a class="hover:underline" href="explore?category=@category">@category</a></li>
                }
            </ul>
        </nav>
    </div>
    <p class="border-t border-ocean-700 py-4 text-center text-sm text-ocean-100">Argawanon &middot; A school project about Argao, Cebu</p>
</footer>

<div id="blazor-error-ui" role="alert">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" aria-label="Dismiss">✕</a>
</div>
