@page "/places/{Slug}"
@inject ReviewStore Reviews

@if (place is null)
{
    <PageTitle>Place not found · Argawanon</PageTitle>
    <section class="container-page py-24 text-center">
        <p class="font-semibold uppercase tracking-widest text-coral-600">Oops</p>
        <h1 class="heading mt-2 text-4xl">We couldn't find that place</h1>
        <p class="mx-auto mt-3 max-w-md text-stone-600">
            There is no listing called <strong>“@Slug”</strong>. The link may be mistyped or the place may have moved.
        </p>
        <a href="explore" class="btn-primary mt-8">Browse all places</a>
    </section>
}
else
{
    var reviews = Reviews.ReviewsFor(place).ToList();

    <PageTitle>@place.Name · Argawanon</PageTitle>

    <div class="container-page pt-8">
        <a href="explore" class="font-semibold text-ocean-700 hover:underline">← Back to Explore</a>

        <figure class="mt-4">
            <img src="@place.Image" alt="@place.ImageAlt" class="aspect-[4/3] w-full rounded-3xl object-cover shadow-sm sm:aspect-[16/9] lg:aspect-[21/9]" />
            <figcaption class="mt-2 text-xs text-stone-500">@place.PhotoCredit</figcaption>
        </figure>

        <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_22rem]">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="badge">@place.Category</span>
                    @if (place.IsDemo)
                    {
                        <span class="demo-tag">Demo listing (fictional)</span>
                    }
                </div>
                <h1 class="heading mt-3 text-4xl sm:text-5xl">@place.Name</h1>
                <p class="mt-2 text-lg text-stone-600">@place.Location</p>
                <p class="mt-3"><Rating Value="Reviews.AverageRating(place)" /> <span class="text-stone-600">from @reviews.Count @(reviews.Count == 1 ? "review" : "reviews")</span></p>

                <p class="mt-6 max-w-prose text-lg leading-relaxed">@place.Description</p>

                <section aria-labelledby="reviews-heading" class="mt-12">
                    <h2 id="reviews-heading" class="heading text-2xl">Reviews</h2>
                    <p class="mt-1 text-sm text-stone-500">
                        Sample reviews are fictional. Reviews you add stay only while you browse and disappear when you refresh the page.
                    </p>
                    <ul class="mt-6 space-y-4">
                        @foreach (var review in reviews)
                        {
                            <li class="card p-5">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <p class="font-bold text-ocean-900">@review.Name</p>
                                    <span class="@(review.IsSample ? "badge" : "demo-tag")">@(review.IsSample ? "Sample review (fictional)" : "Your review")</span>
                                </div>
                                <p class="mt-1 text-coral-500" aria-hidden="true">@(new string('★', review.Rating))<span class="text-sand-200">@(new string('★', 5 - review.Rating))</span></p>
                                <p class="sr-only">Rated @review.Rating out of 5</p>
                                <p class="mt-2 whitespace-pre-line">@review.Comment</p>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <aside class="lg:sticky lg:top-24 lg:self-start">
                <section aria-labelledby="form-heading" class="card p-6">
                    <h2 id="form-heading" class="heading text-2xl">Write a review</h2>
                    <EditForm Model="form" OnValidSubmit="AddReview" class="mt-4 space-y-4">
                        <DataAnnotationsValidator />
                        <div>
                            <label for="review-name" class="field-label">Display name</label>
                            <InputText id="review-name" class="field" @bind-Value="form.Name" maxlength="40" />
                            <ValidationMessage For="() => form.Name" />
                        </div>
                        <div>
                            <label for="review-rating" class="field-label">Rating</label>
                            <InputSelect id="review-rating" class="field" @bind-Value="form.Rating">
                                <option value="">Choose 1 to 5 stars</option>
                                @for (var i = 5; i >= 1; i--)
                                {
                                    <option value="@i">@i @(i == 1 ? "star" : "stars")</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => form.Rating" />
                        </div>
                        <div>
                            <label for="review-comment" class="field-label">Comment</label>
                            <InputTextArea id="review-comment" class="field" rows="4" @bind-Value="form.Comment" maxlength="500" />
                            <ValidationMessage For="() => form.Comment" />
                        </div>
                        <button type="submit" class="btn-primary w-full">Post review</button>
                        <p role="status" class="text-sm font-semibold text-ocean-700">@status</p>
                    </EditForm>
                </section>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Place? place;
    private ReviewForm form = new();
    private string status = "";

    protected override void OnParametersSet()
    {
        place = Places.Find(Slug);
        form = new();
        status = "";
    }

    private void AddReview()
    {
        Reviews.Add(place!, new Review(form.Name!.Trim(), form.Rating!.Value, form.Comment!.Trim()));
        form = new(); // clears the form
        status = "Thanks! Your review was added.";
    }
}
