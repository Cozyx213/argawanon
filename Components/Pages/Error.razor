@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Argawanon</PageTitle>

<section class="container-page py-16">
    <h1 class="heading text-3xl">Something went wrong.</h1>
    <p class="mt-3">An error occurred while processing your request. Please go back to the <a class="font-semibold text-ocean-700 underline" href="">home page</a>.</p>
    @if (ShowRequestId)
    {
        <p class="mt-3 text-sm text-stone-500">Request ID: <code>@RequestId</code></p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
